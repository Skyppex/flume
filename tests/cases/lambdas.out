rill voice(pitch: Pitch, tune: fn(Pitch) Freq) Sample {
    return pitch |> tune |> sine
}

rill main() Sample {
    let tuning = fn(p: Pitch) Freq { equal(p, 12, a4: 440Hz) }
    let a = voice(E4, fn(p) { equal(p, 24) })

    let b = voice(
        E4,
        fn(p) {
            let base = equal(p, 24)
            base * 2
        },
    )

    let c = voice(E4, if minor { just_c } else { equal })

    let d = fn(a: Float, b: Float) Float {
        a * b + a_long_name_for_padding * b_long_name_for_padding
    }

    let e = fn() { 1 }
    return a + b
}

fn takes(
    f: fn(Pitch, Float, Interval, Freq, Time, Gain, Sample, Bool) Freq,
    g: fn() Sample,
) Sample {
    return 0
}
