rill live_control(depth: Freq = 0.5Hz, gain: Sample = 0.25, brightness: Float = 0.75) Sample {
    let voice = some_very_long_function_name(first_argument, second_argument, third_argument)
    let nested = outer_function(inner_function(alpha, beta, gamma, delta), another_inner(epsilon, zeta))
    let chord = [equal(E4, 12, a4: 440Hz), equal(G#4, 12, a4: 440Hz), equal(B4, 12, a4: 440Hz)]
    let piped = input_signal |> highpass(cutoff: 120Hz) |> compressor(ratio: 4, threshold: -18dB) |> limiter
    return a_rather_long_name * another_long_name + yet_another_long_name * one_more_name_here - x
}
rill mix_down<Channels, OtherChannels, YetMoreChannels, AndEvenMoreChannelsHere>(x: [Sample; N]) [Sample; 1] {
    return [sum(x) / N]
}
rill decimate(very_long_parameter_name: Sample, another_very_long_parameter: Sample) Sample @ rate / 2 {
    if some_condition_value > threshold_value_here && other_condition_value < limit_value_x {
        return 0
    }
    let pick = (first_long_operand_name + second_long_operand_name) * (third_long_operand - fourth_one)
    let idx = frame_with_a_long_name[index_computation_value + another_offset_value * stride_amount]
    return x
}
